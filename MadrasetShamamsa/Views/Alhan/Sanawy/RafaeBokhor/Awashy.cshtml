}

<section class="container py-4 bg-white mb-4">
    <div>
        <h1 class="mb-3 text-center">
            <i class="fa-solid fa-hands-praying mx-2 text-primary"></i>
            الأواشي
        </h1>
        <p class="mx-auto">
            الأواشي هي صلوات ترفعها الكنيسة عن الراقدين والمرضى والمسافرين والقرابين.
        </p>
        <ul>
            <li>في رفع بخور عشية دائمًا تقال أوشية الراقدين.</li>
            <li>رفع بخور باكر من يوم الاثنين إلى يوم الجمعة تقال أوشية المرضَى والمسافرين.</li>
            <li>رفع بخور باكر يوم السبت تقال أوشية الراقدين.</li>
            <li>رفع بخور باكر في الآحاد والأعياد السيدية تقال أوشية المرضَى والقرابين.</li>
        </ul>
    </div>
</section>

<section class="container bg-white py-4">
    <div class="accordion" id="awashyAccordion">
        @foreach (var awashy in awashyList)
        {
            <div class="accordion-item mb-3 shadow-sm">
                <h2 class="accordion-header" id="heading@(awashy.id)">
                    <button class="accordion-button @(awashy.id != "rakeden" ? "collapsed" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse@(awashy.id)"
                            aria-expanded="@(awashy.id == "rakeden" ? "true" : "false")"
                            aria-controls="collapse@(awashy.id)">
                        @awashy.title
                    </button>
                </h2>
                <div id="collapse@(awashy.id)"
                     class="accordion-collapse collapse @(awashy.id == "rakeden" ? "show" : "")"
                     aria-labelledby="heading@(awashy.id)"
                     data-bs-parent="#awashyAccordion">
                    <div class="accordion-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0 text-center align-middle">
                                <tbody>
                                    @foreach (var row in awashy.rows)
                                    {
                                        <tr>
                                            <td style="width:33%;">@row.arabic</td>
                                            <td style="width:33%;">@row.pron</td>
                                            <td style="width:33%; font-family: Avva_Shenouda">
                                                @Html.Raw(row.coptic)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>