@{
    ViewData["Title"] = "الألحان";

    var alhanList = new[]
    {
        new { Text = "الألحان السنوية", Controller = "Alhan", Action = "Sanawy" },
        new { Text = "ألحان الأعياد السيدية الصغرى 1", Controller = "Alhan", Action = "" },
        new { Text = "ألحان الأعياد السيدية الصغرى 2", Controller = "Alhan", Action = "" },
        new { Text = "ألحان النيروز والصليب", Controller = "Alhan", Action = "" },
        new { Text = "ألحان كيهك والميلاد", Controller = "Alhan", Action = "" },
        new { Text = "ألحان الغطاس", Controller = "Alhan", Action = "" },
        new { Text = "ألحان الصوم الكبير", Controller = "Alhan", Action = "" },
        new { Text = "ألحان سبت لعازر وأحد الشعانين", Controller = "Alhan", Action = "" },
        new { Text = "ألحان البصخة", Controller = "Alhan", Action = "" },
        new { Text = "ألحان سبت الفرح", Controller = "Alhan", Action = "" },
        new { Text = "ألحان الخمسين المقدسة", Controller = "Alhan", Action = "" },
        new { Text = "ألحان صوم الرسل", Controller = "Alhan", Action = "" },
        new { Text = "ألحان صوم السيدة العذراء", Controller = "Alhan", Action = "" },
        new { Text = "ألحان التسبحة", Controller = "Alhan", Action = "" }
    };
}

<!-- =======================
    HERO / INTRO SECTION
======================= -->
<section class="text-center py-5 bg-white">
    <div class="container">
        <h1 class="display-4 mb-3">
            <i class="fa-solid fa-music mx-2 text-primary"></i>مكتبة الألحان
        </h1>
        <p class="mx-auto">
            هنا يمكنك الوصول إلى جميع الألحان حسب المناسبات والقداسات، لتعلم التسابيح والمردات الخاصة بالشمامسة
        </p>
    </div>
</section>

<!-- =======================
    MELODIES CARDS
======================= -->
<section class="container py-5">
    <div class="row g-4">
        @foreach (var item in alhanList)
        {
            <div class="col-md-4">
                @if (string.IsNullOrEmpty(item.Action))
                {
                    <div class="text-decoration-none">
                        <div class="card text-center h-100 shadow-sm card-hover">
                            <div class="card-body">
                                <h5 class="mb-0 text-dark d-flex align-items-center justify-content-center gap-2">
                                    <i class="fa-solid fa-cross text-primary"></i>
                                    <span>@item.Text</span>
                                </h5>
                                <small class="text-muted">قريباً</small>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <a asp-controller="@item.Controller" asp-action="@item.Action" class="text-decoration-none">
                        <div class="card text-center h-100 shadow-sm card-hover">
                            <div class="card-body">
                                <h5 class="mb-0 text-dark d-flex align-items-center justify-content-center gap-2">
                                    <i class="fa-solid fa-cross text-primary"></i>
                                    <span>@item.Text</span>
                                </h5>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>