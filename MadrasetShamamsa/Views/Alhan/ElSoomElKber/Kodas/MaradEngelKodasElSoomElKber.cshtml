<section class="container py-4 text-center bg-white mb-4">
    <div>
        <h1 class="mb-3">
            <i class="fa-solid fa-hands-praying mx-2 text-primary"></i>
            مرد إنجيل باكر
        </h1>
    </div>
</section>

<section class="container bg-white py-4">
    <div class="accordion" id="itemAccordion">
        @foreach (var item in itemsList)
        {
            <div class="accordion-item mb-3 shadow-sm">
                <h2 class="accordion-header" id="heading@(item.id)">
                    <button class="accordion-button @(item.id != "maradengelsoomnenawa1" ? "collapsed" : "")"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#collapse@(item.id)"
                            aria-expanded="@(item.id == "maradengelsoomnenawa1" ? "true" : "false")"
                            aria-controls="collapse@(item.id)">
                        @item.title
                    </button>
                </h2>
                <div id="collapse@(item.id)"
                     class="accordion-collapse collapse @(item.id == "maradengelsoomnenawa1" ? "show" : "")"
                     aria-labelledby="heading@(item.id)"
                     data-bs-parent="#itemAccordion">
                    <div class="accordion-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped mb-0 text-center align-middle">
                                <tbody>
                                    @foreach (var row in item.rows)
                                    {
                                        <tr>
                                            <td style="width:33%;">@row.arabic</td>
                                            <td style="width:33%;">@row.pron</td>
                                            <td style="width:33%; font-family: '@item.font'; font-size: 16pt;" dir="ltr">@Html.Raw(row.coptic)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>