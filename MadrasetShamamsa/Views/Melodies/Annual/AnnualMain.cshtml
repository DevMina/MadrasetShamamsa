<section class="py-3 text-center bg-light">
    <div class="container">
        <h1 class="mb-3">ألحان السنوي</h1>
        <p class="lead text-muted">
            الألحان التي تُرتَّل في الأيام العادية طوال السنة القبطية خارج المواسم الكبرى.
        </p>
    </div>
</section>

<section class="py-3">
    <div class="container">
        <div class="accordion" id="sectionsAccordion">
            @foreach (var sec in sections)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(sec.id != "1" ? "collapsed" : "")" type="button" data-bs-toggle="collapse" data-bs-target="#section@(sec.id.Trim())" aria-expanded="@(sec.id == "1" ? "true" : "false")" aria-controls="section@(sec.id.Trim())">
                            <i class="fa-solid fa-cross mx-2"></i>
                            @sec.name
                        </button>
                    </h2>
                    <div id="section@(sec.id.Trim())" class="accordion-collapse collapse @(sec.id == "1" ? "show" : "")" data-bs-parent="#sectionsAccordion">
                        <div class="accordion-body">
                            <div class="row g-4">
                                @foreach (var subSec in subSections.Where(i => i.sectionId.Trim().Equals(sec.id.Trim())))
                                {
                                    <div class="col-md-4">
                                        <a asp-controller="@subSec.controller" asp-action="@subSec.action" class="text-decoration-none">
                                            <div class="card text-center h-100 shadow-sm card-hover">
                                                <div class="card-body">
                                                    <h5 class="mb-0 text-dark">@subSec.name</h5>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>