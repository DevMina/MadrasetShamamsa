@{
    ViewData["Title"] = "الألحان";
}
<!-- =======================
    HERO / INTRO SECTION
======================= -->
<section class="text-center py-5 bg-white">
    <div class="container">
        <h1 class="display-4 mb-3">
            <i class="fa-solid fa-music mx-2 text-primary"></i>مكتبة الألحان
        </h1>
        <p class="mx-auto">
            هنا يمكنك الوصول إلى جميع الألحان حسب المناسبات والقداسات، لتعلم التسابيح والمردات الخاصة بالشمامسة
        </p>
    </div>
</section>
<!-- =======================
    MELODIES CARDS
======================= -->
<section class="container py-5">
    <div class="row g-4">
        <!-- Annual Melodies -->
        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
                <div class="card-body d-flex flex-column">
                    <i class="fa-solid fa-calendar-alt fa-2x mb-3 text-primary"></i>
                    <h4>الألحان السنوية</h4>
                    <p class="flex-grow-1">ألحان ومردات القداسات السنوي</p>
                    <a href="/Melodies/Annual" class="btn btn-outline-primary mt-auto">عرض الألحان</a>
                </div>
            </div>
        </div>
        <!-- Annual Melodies -->
        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
