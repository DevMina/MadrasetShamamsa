@{
    ViewData["Title"] = "العقيدة الكنسية";
}

<!-- =======================
    HERO / INTRO SECTION
======================= -->
<section class="container py-3 bg-white mb-5">
    <div>
        <h1 class="mb-3">
            <i class="fa-solid fa-gavel mx-2 text-primary"></i>العقيدة الكنسية
        </h1>
        <p class="mx-auto">
            العقيدة الكنسية هي أساس الإيمان المسيحي والقبطي، وتشمل مفاهيم مثل الثالوث
            الأقدس، سر المسيح، الكنيسة، والأسرار المقدسة. فهم العقيدة يعمّق الروحانية
            ويقوي خدمة الشمامسة.
        </p>
    </div>
</section>

<!-- =======================
    DOCTRINE CARDS
======================= -->
<section class="container py-3 bg-white">
    <h2 class="mb-4">أهم عناصر العقيدة</h2>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
                <i class="fa-solid fa-cross fa-2x mb-3 text-primary"></i>
                <h4>الثالوث الأقدس</h4>
                <p>الله الآب، الابن، والروح القدس؛ وحدة واحدة في ثلاثة أقانيم.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
                <i class="fa-solid fa-dove fa-2x mb-3 text-primary"></i>
                <h4>المسيح</h4>
                <p>الإيمان بأن يسوع المسيح هو ابن الله، مخلص البشرية وفاديها.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
                <i class="fa-solid fa-church fa-2x mb-3 text-primary"></i>
                <h4>الكنيسة</h4>
                <p>الكنيسة القبطية كمؤسسة روحية لتعليم الإيمان وتقديم الأسرار المقدسة.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
                <i class="fa-solid fa-hand-holding-droplet fa-2x mb-3 text-primary"></i>
                <h4>الأسرار المقدسة</h4>
                <p>المعمودية، الإفخارستيا، الزواج، وغيرها من الأسرار التي تمثل الحياة الروحية.</p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 p-3 text-center">
                <i class="fa-solid fa-book-open fa-2x mb-3 text-primary"></i>
                <h4>الكتابات المقدسة</h4>
                <p>الإنجيل والمخطوطات القديمة كأساس للعقيدة والطقوس الكنسية.</p>
            </div>
        </div>

    </div>
</section>
