@{
    ViewData["Title"] = "طقس القداس الإلهي";
}

<section class="text-center mb-5">
    <h1 class="fw-bold">طقس القداس الإلهي</h1>
    <p class="text-muted">اضغط على أي مرحلة لعرض شرحها الكامل</p>
</section>

<div class="timeline">

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>رفع بخور عشية وباكر</h4>
                <p>صلوات الاستعداد الروحي قبل بدء القداس</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item left">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>لبس التونية والمزامير</h4>
                <p>الاستعداد بالصلاة والملابس الطقسية</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>تقديم الحمل</h4>
                <p>اختيار الذبيحة وتجهيزها</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item left">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>قداس الموعوظين</h4>
                <p>جزء تعليمي في القداس قراءات من الكتاب المقدس</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>صلاة الصلح</h4>
                <p>ترتيبها و طقسها</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item left">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>الأنافورا</h4>
                <p>تسبيح مع الملائكة</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>قدوس</h4>
                <p>قصة الإنسان من الخليقة حتى مجيء ربنا يسوع</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item left">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>تجسد و تأنس</h4>
                <p>خطة الخلاص اللي عملها ربنا يسوع لأجلنا</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>التقديس</h4>
                <p>قدس أقداس القداس اللي فيه بنفتكر العشاء الرباني و الروح القدس بيحوّل الخبز و الخمر إلى جسد و دم حقيقي ليسوع المسيح</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item left">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>الأواشي و الطلبات</h4>
                <p>بوجود المسيح معانا بنطلب كل طلباتنا</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>المجمع و الترحيم</h4>
                <p>بنذكر القديسين و آبائنا اللي سبقونا على السماء</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item left">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>القسمة</h4>
                <p>بنطلب من ربنا يطهرنا ويخلينا مستعدين للتناول وبنشكره انه سمح لنا نعيش اللحظة المقدسة دي</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

    <div class="timeline-item right">
        <a class="timeline-link" href="#">
            <div class="content">
                <h4>الاعتراف والتناول</h4>
                <p>بنعترف إن ده جسد ودم حقيقي لربنا يسوع ونفتكر خطة الخلاص اللي عملها لأجلنا</p>
                <div class="hint">اضغط للتفاصيل</div>
            </div>
        </a>
    </div>

</div>
