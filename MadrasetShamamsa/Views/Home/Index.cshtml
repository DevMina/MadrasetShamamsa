@{
    ViewData["Title"] = "Home page";

    var today = DateTime.Now.ToString("dddd, d MMMM yyyy");
    var copticDate = ViewBag.CopticDate;
}

<div class="container mt-4">
    <!-- =======================
        HERO SECTION
    ======================= -->
    <h3 class="mb-4 text-center icon-primary">
        <i class="fa-solid fa-church mx-2 text-primary"></i>مدرسة الشمامسة
    </h3>

    <!-- =======================
        QUOTE + DATE CARDS
    ======================= -->
    <div class="row g-3 justify-content-center mb-4">
        <div class="row g-3">
            <!-- Quote Card -->
            <div class="col-lg-8 col-md-7 col-12 d-flex">
                <div class="card shadow-sm flex-fill d-flex flex-column h-100 overflow-hidden">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-blockquote-right"></i>
                            شعار الخدمة
                            <i class="bi bi-blockquote-left"></i>
                        </h5>
                    </div>
                    <div class="card-body d-flex flex-row align-items-center p-0">
                        <div class="d-none d-md-flex align-items-center p-3">
                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 384 512"
                                 width="90" height="90"
                                 class="text-primary"
                                 style="opacity: 0.4; flex-shrink: 0; margin-inline-start: 1rem;">
                                <path fill="currentColor"
                                      d="M176 0c-26.5 0-48 21.5-48 48v80H48
               c-26.5 0-48 21.5-48 48v32c0 26.5
               21.5 48 48 48h80V464c0 26.5
               21.5 48 48 48h32c26.5 0 48-21.5
               48-48V256h80c26.5 0 48-21.5
               48-48V176c0-26.5-21.5-48-48-48H256V48
               c0-26.5-21.5-48-48-48H176z" />
                            </svg>
                        </div>
                        <div class="p-4 flex-grow-1">
                            <blockquote class="mb-0">
                                <h4 class="fw-semibold text-dark mb-3">
                                    "لأَنَّ الَّذِينَ تَشَمَّسُوا حَسَنًا، يَقْتَنُونَ لأَنْفُسِهِمْ دَرَجَةً حَسَنَةً وَثِقَةً كَثِيرَةً فِي الإِيمَانِ الَّذِي بِالْمَسِيحِ يَسُوعَ."
                                </h4>
                                <footer class="text-muted fs-5">(1 تي 3: 13)</footer>
                            </blockquote>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date Card -->
            <div class="col-lg-4 col-md-5 col-sm-6 col-12 d-flex">
                <div class="card shadow-sm flex-fill d-flex flex-column h-100 overflow-hidden">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-calendar-event me-2"></i>
                            تاريخ اليوم
                        </h5>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-center p-4">
                        <h3 class="fw-bold text-dark mb-2">@today</h3>
                        <p class="text-muted fs-5 mb-0">@copticDate</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =======================
        ABOUT CARD
    ======================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-5">
            <h2 class="text-center mb-3"><i class="bi bi-people-fill mx-2 text-primary"></i>من نحن</h2>
            <p class="text-center w-75 mx-auto">
                مدرسة الشمامسة تهدف إلى تعليم الألحان والتراث الكنسي وتقديم منهج سليم
                قائم على الطقس القبطي والعلوم الكنسية، لإعداد شماس خادم ودارس
            </p>
        </div>
    </div>

    <!-- =======================
        LITURGY SECTION CARD
    ======================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-5">
            <h2 class="text-center mb-4"><i class="bi bi-music-note-beamed mx-2 text-primary"></i>مكتبة الألحان</h2>

            <p class="text-center w-75 mx-auto mb-4">
                تحتوي مكتبة الألحان على تقسيمات شاملة لكل المناسبات الكنسية، مرفقة بالشرح
                والتسجيلات، لمساعدة الدارس على فهم اللحن ومناسبته داخل طقس الكنيسة
            </p>

            <div class="text-center mt-3">
                <a asp-controller="Alhan" asp-action="AlhanList" class="btn btn-outline-primary mt-auto">الدخول إلى مكتبة الألحان</a>
            </div>
        </div>
    </div>

    <!-- =======================
        CHURCH SCIENCES CARD
    ======================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-5">
            <h2 class="text-center mb-4"><i class="bi bi-book-half mx-2 text-primary"></i>قسم العلوم الكنسية</h2>

            <p class="text-center w-75 mx-auto mb-4">
                يشمل هذا القسم دراسة الطقس القبطي، العقيدة، اللغة القبطية، وتاريخ الكنيسة
                تم تنظيم المواد بطريقة مبسطة وواضحة تساعد الدارس على فهم الأسس الروحية
                والليتورچية للكنيسة القبطية
            </p>

            <div class="text-center mt-3">
                <a asp-controller="EilomElKanesa" asp-action="EilomElKanesa" class="btn btn-outline-primary mt-auto">الدخول إلى العلوم الكنسية</a>
            </div>
        </div>
    </div>

    <!-- =======================
        CONTACT CARD
    ======================= -->
    <div class="card shadow-sm mb-4">
        <div class="card-body py-5">
            <h2 class="text-center mb-4"><i class="bi bi-envelope-fill mx-2 text-primary"></i>اتصل بنا</h2>
            <h5 class="text-center mb-4">أي تعليق أو اقتراح هيفيدنا جداً</h5>

            <div class="row">
                <div class="col-md-7 mx-auto">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-person-fill mx-2 text-primary"></i>الاسم</label>
                            <input type="text" name="name" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-envelope-at-fill mx-2 text-primary"></i>البريد الإلكتروني</label>
                            <input type="email" name="email" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-phone-fill mx-2 text-primary"></i>الموبايل</label>
                            <input type="tel" name="mobile" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label"><i class="bi bi-chat-left-dots-fill mx-2 text-primary"></i>الرسالة</label>
                            <textarea name="message" class="form-control" rows="5" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-outline-primary mt-auto">إرسال</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>